@model Promotion
@{ ViewData["Title"]=string.IsNullOrWhiteSpace(Model.Title)?"Add promotion":"Edit promotion"; }
<div class="page-heading"><div><span class="eyebrow">ADMINISTRATION</span><h1>@ViewData["Title"]</h1><p>Publish a promotion for all users or a selected region.</p></div><a class="button secondary" asp-action="Index">← Promotions</a></div>
<form asp-action="Save" method="post" class="form-section promotion-form"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><div class="grid two"><div><label asp-for="Title"></label><input asp-for="Title"/></div><div><label asp-for="Region"></label><select asp-for="Region"><option>All regions</option><option>Cape Town</option><option>Gauteng</option><option>KwaZulu-Natal</option></select></div><div><label asp-for="StartDate">Start date</label><input asp-for="StartDate" type="date"/></div><div><label asp-for="EndDate">End date</label><input asp-for="EndDate" type="date"/></div><div><label asp-for="DocumentUrl">PDF path</label><input asp-for="DocumentUrl" placeholder="/promotions/file.pdf"/></div><div><label asp-for="DocumentFileName">Download filename</label><input asp-for="DocumentFileName"/></div></div><label asp-for="Description"></label><textarea asp-for="Description" rows="6"></textarea><label class="toggle-row"><input asp-for="IsPublished"/><span><strong>Published</strong><small>Visible to users during the promotion dates.</small></span></label><div class="form-actions"><a class="button secondary" asp-action="Index">Cancel</a><button class="button primary" type="submit">Save promotion</button></div></form>
