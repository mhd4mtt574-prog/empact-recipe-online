@model RegisterViewModel
@{ ViewData["Title"]="Register"; }
<section class="form-page narrow"><div class="section-heading"><div><h1>Create your account</h1><p>Register for access to your assigned unit.</p></div></div>
<form method="post" class="editor-card"><div asp-validation-summary="ModelOnly" class="validation"></div>
<div class="grid two"><div><label asp-for="DisplayName"></label><input asp-for="DisplayName" /></div><div><label asp-for="Username"></label><input asp-for="Username" /></div>
<div><label asp-for="Unit"></label><select asp-for="Unit">@foreach(string unit in ViewBag.Units){<option>@unit</option>}</select></div><div></div>
<div><label asp-for="Password"></label><input asp-for="Password" /></div><div><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" /></div></div>
<div class="actions"><a class="button secondary" asp-action="Login">Back</a><button class="primary" type="submit">Register</button></div></form></section>
