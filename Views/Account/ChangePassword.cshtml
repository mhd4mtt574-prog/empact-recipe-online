@model ChangePasswordViewModel
@{ ViewData["Title"]="Change password"; }
<section class="auth-shell auth-password-shell">
  <div class="auth-brand-panel login-hero"><div class="login-overlay"></div><img class="auth-logo-large" src="/images/food-logo.png" alt="Food by Empact Group"/><div class="auth-brand-copy"><span>ACCOUNT SECURITY</span><h2>Create your private password.</h2><p>Your temporary password must be replaced before you can use the recipe library.</p></div></div>
  <div class="auth-card-wrap"><div class="auth-card"><span class="eyebrow">FIRST SIGN IN</span><h1>Change your password</h1><p>Choose a password of at least eight characters.</p><form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="CurrentPassword">Temporary password</label><input asp-for="CurrentPassword" autocomplete="current-password"/><span asp-validation-for="CurrentPassword"></span><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password"/><span asp-validation-for="NewPassword"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword"></span><button class="button primary wide auth-submit" type="submit">Save new password →</button></form></div></div>
</section>
