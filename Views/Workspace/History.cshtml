@model List<ActivityLog>
@{ ViewData["Title"]="Audit & Change History"; var units=(List<string>)ViewBag.Units; var actions=(List<string>)ViewBag.Actions; }
<section class="workspace-hero compact"><div><span class="food-eyebrow">ADMINISTRATION</span><h1>Audit & change history</h1><p>Search who changed, submitted, viewed or downloaded information in the platform.</p></div><button type="button" onclick="window.print()" class="brand-button outline no-print">Print report</button></section>
<form method="get" class="history-filter no-print"><input name="q" value="@ViewBag.Query" placeholder="User, item or note…"/><select name="unit"><option value="">All units</option>@foreach(var u in units){<option value="@u" selected="@(u==(string)ViewBag.Unit)">@u</option>}</select><select name="action"><option value="">All actions</option>@foreach(var a in actions){<option value="@a" selected="@(a==(string)ViewBag.Action)">@a</option>}</select><input type="date" name="from" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))"/><input type="date" name="to" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))"/><button class="brand-button primary">Filter</button></form>
<section class="workspace-card"><div class="audit-table"><div class="audit-head"><span>Date/time</span><span>User</span><span>Unit</span><span>Action</span><span>Item</span><span>Details</span></div>@foreach(var x in Model){<div class="audit-row"><span>@x.OccurredAtUtc.ToLocalTime().ToString("dd MMM yy HH:mm")</span><span>@x.UserName<small>@x.UserRole</small></span><span>@x.Unit<small>@x.Region</small></span><span>@x.Action</span><span>@x.EntityName</span><span>@x.Notes</span></div>}</div></section>
