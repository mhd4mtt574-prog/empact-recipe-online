@model Recipe
@{ 
    ViewData["Title"] = Model.Name;
    var portions = (int)ViewBag.DisplayPortions;
    var isAdmin = User.IsInRole("Administrator");
    var total = Model.Ingredients.Sum(i => i.GetLineCost(Model.EffectiveBasePortions, portions, Model.WastePercent));
    var costPerPortion = total / Math.Max(1, portions);
    var desiredMarginPercent = (decimal)ViewBag.DesiredMarginPercent;
    var marginUnit = (string)ViewBag.MarginUnit;
    var sellingPrice = desiredMarginPercent >= 100 ? 0 : costPerPortion / (1 - desiredMarginPercent / 100m);
    var profitPerPortion = sellingPrice - costPerPortion;
    var recipeRegion = (string)(ViewBag.RecipeRegion ?? "Current region");
    var hasNutrition = Model.EnergyKjPerPortion > 0 || Model.EnergyKcalPerPortion > 0 || Model.ProteinGramsPerPortion > 0 || Model.CarbohydrateGramsPerPortion > 0 || Model.FatGramsPerPortion > 0 || Model.SodiumMgPerPortion > 0;
    var nutritionAnalysis = ViewBag.NutritionAnalysis as EmpactRecipeOnline.Models.RecipeNutritionAnalysisResult;
}
<div class="detail-actions no-print"><a class="button secondary" asp-action="Index">← Recipes</a><div><form method="post" asp-controller="Workspace" asp-action="ToggleFavourite" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="entityType" value="Recipe"/><input type="hidden" name="entityId" value="@Model.Id"/><input type="hidden" name="name" value="@Model.Name"/><input type="hidden" name="url" value="/Recipes/Details/@Model.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString"/><button class="button secondary" type="submit">★ Favourite</button></form>@if(isAdmin){<a class="button secondary" asp-controller="RecipeAplLinks" asp-action="Index" asp-route-recipeId="@Model.Id">Link APL items</a><a class="button secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit recipe</a>}<button class="button primary" type="button" onclick="window.print()">Print recipe</button></div></div>
<article class="recipe-sheet">
<header class="sheet-header"><img src="~/images/food-logo.png" alt="Food by Empact Group"/><div><span class="eyebrow">STANDARDISED RECIPE</span><h1>@Model.Name</h1><p>@Model.Code · @Model.Department · @Model.Category · @recipeRegion product list</p></div><div class="approval">@(Model.IsApproved?"APPROVED":"DRAFT")<small>Version @Model.Version</small></div></header>
<section class="portion-margin-panel no-print">
<form method="get" class="portion-scaler">
<label for="portions">Required portions</label>
<div><input id="portions" name="portions" type="number" min="1" max="100000" value="@portions"/><button class="button primary" type="submit">Recalculate</button></div>
<p>Changing portions adjusts this view and printout only. The master recipe is not changed.</p>
</form>
<form method="post" asp-action="UpdateDesiredMargin" class="margin-editor">
@Html.AntiForgeryToken()
<input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="portions" value="@portions"/>
<label for="desiredMarginPercent">Desired GP margin %</label>
<div><input id="desiredMarginPercent" name="desiredMarginPercent" type="number" min="0" max="99.99" step="0.01" value="@desiredMarginPercent.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"/><button class="button primary" type="submit">Save margin</button></div>
<p>Saved for @marginUnit. Other units can use a different margin.</p>
</form>
</section>
<section class="summary-grid user-summary"><div><span>Standard recipe portions</span><strong>@Model.StandardPortions</strong></div><div><span>Selected portions</span><strong>@portions</strong></div><div><span>Desired GP margin</span><strong>@(desiredMarginPercent.ToString("N2"))%</strong></div><div><span>Required selling price / portion</span><strong>R @(sellingPrice.ToString("N2"))</strong></div><div><span>Recipe version</span><strong>@Model.Version</strong></div>@if(isAdmin){<div><span>Total batch cost</span><strong>R @(total.ToString("N2"))</strong></div><div><span>Cost per portion</span><strong>R @(costPerPortion.ToString("N2"))</strong></div><div><span>Selling price / portion</span><strong>R @(sellingPrice.ToString("N2"))</strong></div><div><span>Profit / portion</span><strong>R @(profitPerPortion.ToString("N2"))</strong></div><div><span>Profit margin</span><strong>@(desiredMarginPercent.ToString("N2"))%</strong></div>}</section>
<section><h2>Ingredients and stock issue</h2><div class="table-wrap"><table class="stock-issue-table"><thead><tr>@if(isAdmin){<th>APL code</th>}<th>Product</th>@if(isAdmin){<th class="screen-only">Cooking notes</th><th class="screen-only">Pack size</th><th class="screen-only">Purchase price</th><th class="screen-only">Factor</th><th class="screen-only">Standard qty</th>}<th>Required qty</th><th>Unit</th><th class="stock-issue-column">Stock issue</th><th class="stock-issue-column">Issued by</th>@if(isAdmin){<th class="screen-only">Waste factor</th><th class="screen-only">Batch cost</th><th class="screen-only">Cost / portion</th>}</tr></thead><tbody>@foreach(var line in Model.Ingredients){var issue=line.GetBatchIssue(Model.EffectiveBasePortions,portions);var waste=line.GetWasteCost(Model.EffectiveBasePortions,portions,Model.WastePercent);var cost=line.GetLineCost(Model.EffectiveBasePortions,portions,Model.WastePercent);<tr>@if(isAdmin){<td>@line.ProductCode</td>}<td>@line.Name</td>@if(isAdmin){<td class="screen-only">@line.CookingNotes</td><td class="screen-only">@line.PackSize</td><td class="screen-only">R @(line.UnitCost.ToString("N2"))</td><td class="screen-only">@(line.EffectiveFactor.ToString("N4"))</td><td class="screen-only">@(line.Quantity.ToString("N4"))</td>}<td>@(issue.ToString("N4"))</td><td>@line.Unit</td><td class="stock-issue-column"><span class="issue-write-line"></span></td><td class="stock-issue-column"><span class="issue-write-line"></span></td>@if(isAdmin){<td class="screen-only">R @(waste.ToString("N2"))</td><td class="screen-only">R @(cost.ToString("N2"))</td><td class="screen-only">R @((cost / Math.Max(1, portions)).ToString("N2"))</td>}</tr>}</tbody></table></div></section>
<div class="grid two content-sections"><section><h2>Method</h2><p class="preserve">@Model.Method</p></section><section><h2>Serving instructions</h2><p class="preserve">@(string.IsNullOrWhiteSpace(Model.ServingInstructions)?"Not specified.":Model.ServingInstructions)</p></section></div>
<section class="nutrition-panel">
<div class="section-heading-inline"><div><h2>Nutritional analysis</h2><p class="muted">Ingredient-based estimate for one finished portion.</p></div><span class="nutrition-status @(Model.NutritionVerified?"verified":"estimated")">@(Model.NutritionVerified?"Verified":"Estimated")</span></div>
@if(isAdmin){<form method="post" asp-action="GenerateNutrition" class="nutrition-generate-form no-print">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="portions" value="@portions"/><button class="button primary" type="submit">↻ Generate / refresh nutrition</button><small>Uses South African SAFOODS reference data first when a licensed local file is available; optional USDA fallback is clearly identified.</small></form>}
@if(hasNutrition){<p class="nutrition-basis">Approximate values for 1 finished portion. Coverage: @(Model.NutritionCoveragePercent.ToString("N0"))% of ingredient lines.</p><div class="nutrition-grid"><div><span>Energy</span><strong>@(Model.EnergyKjPerPortion.ToString("N0")) kJ</strong><small>@(Model.EnergyKcalPerPortion.ToString("N0")) kcal</small></div><div><span>Protein</span><strong>@(Model.ProteinGramsPerPortion.ToString("N1")) g</strong></div><div><span>Carbohydrate</span><strong>@(Model.CarbohydrateGramsPerPortion.ToString("N1")) g</strong></div><div><span>Total sugar</span><strong>@(Model.SugarGramsPerPortion.ToString("N1")) g</strong></div><div><span>Total fat</span><strong>@(Model.FatGramsPerPortion.ToString("N1")) g</strong></div><div><span>Saturated fat</span><strong>@(Model.SaturatedFatGramsPerPortion.ToString("N1")) g</strong></div><div><span>Fibre</span><strong>@(Model.FibreGramsPerPortion.ToString("N1")) g</strong></div><div><span>Sodium</span><strong>@(Model.SodiumMgPerPortion.ToString("N0")) mg</strong></div></div>}else{<p>No automatic nutritional analysis has been generated for this recipe yet.</p>}
@if(nutritionAnalysis is not null && nutritionAnalysis.Ingredients.Count>0){<details class="nutrition-breakdown" open><summary>Ingredient nutrition contribution</summary><div class="table-wrap"><table><thead><tr><th>Ingredient</th><th>Recipe quantity</th><th>Estimated weight / 1 portion</th><th>Reference match</th><th>Energy</th><th>Protein</th><th>Carbs</th><th>Fat</th><th>Status</th></tr></thead><tbody>@foreach(var n in nutritionAnalysis.Ingredients){<tr class="@(n.RequiresReview?"nutrition-review":"")"><td><strong>@n.IngredientName</strong>@if(!string.IsNullOrWhiteSpace(n.ProductCode)){<small>@n.ProductCode</small>}</td><td>@n.RecipeQuantity.ToString("N3") @n.RecipeUnit</td><td>@(n.EstimatedGrams.HasValue ? n.EstimatedGrams.Value.ToString("N0")+" g" : "—")</td><td>@n.SourceFoodName@if(!string.IsNullOrWhiteSpace(n.SourceSystem)){<small>@n.SourceSystem @n.SourceReferenceCode</small>}</td><td>@(n.IncludedInTotal?n.EnergyKcal.ToString("N0")+" kcal":"—")</td><td>@(n.IncludedInTotal?n.ProteinGrams.ToString("N1")+" g":"—")</td><td>@(n.IncludedInTotal?n.CarbohydrateGrams.ToString("N1")+" g":"—")</td><td>@(n.IncludedInTotal?n.FatGrams.ToString("N1")+" g":"—")</td><td>@if(n.IncludedInTotal && !n.RequiresReview){<span class="nutrition-ok">Included</span>}else{<span class="nutrition-needs-review">Review</span>}@if(!string.IsNullOrWhiteSpace(n.Note)){<small>@n.Note</small>}</td></tr>}</tbody></table></div></details>}
@if(!Model.NutritionVerified){<p class="nutrition-warning">Automatic nutrition is an estimate for one finished portion. Ingredient matches, supplier-specific products, preparation losses, volume/count conversions and finished serving yield must be verified before values are used for formal nutrition labelling or therapeutic diets.</p>}
</section>
<section class="diet-panel"><h2>Special-diet suitability</h2>@if(Model.SpecialDiets.Count>0){<div class="diet-tags">@foreach(var diet in Model.SpecialDiets){<span>@diet</span>}</div>}else{<p>No special-diet suitability has been approved for this recipe.</p>}@if(Model.DietitianApprovalRequired){<p class="dietitian-warning">Therapeutic diet suitability requires dietitian approval.</p>}<p class="diet-disclaimer">Suitability depends on the exact approved ingredients, supplier declarations, preparation controls and prevention of cross-contact.</p></section>
<section class="allergen-box"><h2>Allergen declaration — @ViewBag.RecipeRegion</h2><p class="muted">Automatically scanned from ingredient names and the exact approved products selected for this region, together with administrator declarations.</p><div><strong>Contains:</strong> @(Model.Allergens.Count==0?"No allergens detected — supplier labels must still be verified.":string.Join(", ",Model.Allergens))</div><div><strong>May contain:</strong> @(Model.MayContainAllergens.Count==0?"None detected or recorded":string.Join(", ",Model.MayContainAllergens))</div>@if(Model.SupplierVerificationRequired){<p>⚠ Supplier label verification is required for one or more compound ingredients.</p>}@if(Model.AllergenDetectionSources.Count>0){<details class="allergen-sources"><summary>Show what triggered these warnings</summary><table><thead><tr><th>Allergen / action</th><th>Ingredient</th><th>Detected from</th></tr></thead><tbody>@foreach(var item in Model.AllergenDetectionSources){<tr><td>@(item.IsMayContain?"May contain ":"")@item.Allergen</td><td>@item.IngredientName</td><td>@item.DetectionType — @item.Detail</td></tr>}</tbody></table></details>}</section>
@if(isAdmin){<section class="print-profit-summary"><h2>Cost and profit summary</h2><table><tbody><tr><th>Cost per portion</th><td>R @(costPerPortion.ToString("N2"))</td></tr><tr><th>Selling price per portion</th><td>R @(sellingPrice.ToString("N2"))</td></tr><tr><th>Profit per portion</th><td>R @(profitPerPortion.ToString("N2"))</td></tr><tr><th>Profit margin</th><td>@(desiredMarginPercent.ToString("N2"))%</td></tr></tbody></table></section>}
<footer class="sheet-footer">Updated @(Model.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")) by @Model.UpdatedBy</footer>
</article>
